# LLM Configuration
LLM_API_KEY=your_openai_or_anthropic_api_key
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# Search Configuration
SEARCH_API_KEY=your_serpapi_or_tavily_api_key
SEARCH_PROVIDER=serpapi

# Medium Configuration
MEDIUM_TOKEN=your_medium_integration_token
MEDIUM_PUBLICATION_ID=your_publication_id_optional

# Publishing Settings
ARTICLES_PER_DAY=1
MIN_ARTICLE_WORDS=1200
MAX_ARTICLE_WORDS=2000

# Content Categories (comma-separated)
CONTENT_CATEGORIES=AI,Software Engineering,Java,Spring Boot,AWS,Cloud,Developer Productivity,Programming,Open Source,Developer Tools,Technology Trends,Career Growth for Developers

# Feature Flags
ENABLE_RESEARCH=true
ENABLE_FACT_CHECK=true
ENABLE_DUPLICATE_CHECK=true

# Execution Mode
DRY_RUN=false

# Database
DATABASE_PATH=data/articles.db

# Logging
LOG_LEVEL=INFO

# Retry Configuration
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY=2.0